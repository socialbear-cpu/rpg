{
  "name": "rpg-tooling",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "supabase": "^3.1.0"
  },
  "scripts": {
    "build": "npm run build --workspace frontend",
    "dev": "npx vercel dev -L",
    "test": "npm test --workspace @rpg/backend && npm test --workspace @rpg/frontend",
    "typecheck": "npm run typecheck --workspace @rpg/backend && npm run typecheck --workspace @rpg/frontend"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
