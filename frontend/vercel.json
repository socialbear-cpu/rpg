{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "https://rpg-backend-xi.vercel.app/healthz"
    },
    {
      "source": "/api/:path*",
      "destination": "https://rpg-backend-xi.vercel.app/api/:path*"
    }
  ]
}
