{
  "name": "@rpg/frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build --workspace @rpg/backend --prefix .. && next dev",
    "build": "npm run build --workspace @rpg/backend --prefix .. && next build",
    "start": "next start",
    "typecheck": "npm run build --workspace @rpg/backend --prefix .. && next typegen && tsc --noEmit",
    "test": "npm run build --workspace @rpg/backend --prefix .. && vitest run"
  },
  "dependencies": {
    "@rpg/backend": "*",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
